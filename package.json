{
  "homepage": "https://christophercarrollsmith.com",
  "author": "Christopher Carroll Smith <christopher.smith@promptlytechnologies.com>",
  "name": "christophercarrollsmith-website",
  "private": false,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "generate:pdf": "tsx scripts/generate-cv-pdf.ts",
    "sync:substack": "tsx scripts/sync-substack.ts",
    "sync:youtube": "tsx scripts/sync-youtube.ts",
    "backfill:substack-alts": "tsx scripts/backfill-substack-img-alts.ts",
    "backfill:substack-image-chrome": "tsx scripts/backfill-substack-image-chrome.ts",
    "render:mermaid": "tsx scripts/render-mermaid-images.ts",
    "test:unit": "vitest run",
    "build": "npm run sync:substack && npm run sync:youtube && npm run generate:pdf && npm run render:mermaid && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "test": "playwright test",
    "test:a11y": "playwright test tests/cv-a11y.spec.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:e2e": "npm run test && npm run test:a11y",
    "check": "npm run lint && astro check && astro build && npm run test:e2e",
    "lighthouse": "npm run build && lhci autorun --config=./lighthouserc.json"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/sitemap": "^3.6.0",
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "0.7.21",
    "@citation-js/plugin-csl": "^0.7.21",
    "@formspree/react": "^2.5.1",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.5.0",
    "image-size": "^2.0.2",
    "pdfmake": "^0.2.20",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "roboto-fontface": "^0.10.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/react": "^4.4.1",
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pdfmake": "^0.2.12",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "astro": "^5.15.3",
    "eslint": "^8.38.0",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "json-schema-to-typescript": "^15.0.4",
    "mermaid": "^11.12.2",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
