---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import FieldBackground from '../components/FieldBackground.astro';
import HomeClient from '../components/HomeClient.tsx';
import About from '../components/About.tsx';
import Projects from '../components/Projects.tsx';
import ProjectFeature from '../components/ProjectFeature.tsx';
import Writing from '../components/Writing.tsx';
import Events from '../components/Events.tsx';
import Footer from '../components/Footer.tsx';
import { buildHomeJsonLd, SITE_DESCRIPTION, SITE_NAME } from '../seo/sitePerson';
import '../App.css';
---

<BaseLayout
  title={SITE_NAME}
  description={SITE_DESCRIPTION}
  type="website"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(buildHomeJsonLd())} />
  </Fragment>
  <FieldBackground />
  <div class="App">
    <HeaderAstro />
    <main>
      <HomeClient client:load />
      <About client:load />
      <Projects client:load />
      <ProjectFeature client:load />
      <Writing client:only="react" />
      <Events client:only="react" />
    </main>
    <Footer client:load />
  </div>
</BaseLayout>
