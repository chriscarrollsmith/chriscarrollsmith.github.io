---
import './Header.css';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
---

<header id="header" data-home-page={isHome ? 'true' : undefined}>
  <div class="header-progress" aria-hidden="true">
    <div class="header-progress-fill"></div>
  </div>
  <div class="header-bar">
    <a
      href="/#home"
      class="header-brand"
      data-hash-link
      aria-label="Christopher Carroll Smith — Home"
    >
      <span class="header-brand-short" aria-hidden="true">CCS</span>
      <span class="header-brand-full">Christopher Carroll Smith</span>
    </a>

    <button
      type="button"
      class="header-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open menu"
    >
      <span class="header-toggle-bars" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" aria-label="Primary">
      <a href="/#home" data-hash-link data-section="home">Home</a>
      <a href="/#about" data-hash-link data-section="about">About</a>
      <a href="/#projects" data-hash-link data-section="projects">Projects</a>
      <a href="/#writing" data-hash-link data-section="writing">Writing</a>
      <a href="/#events" data-hash-link data-section="events">Events</a>
      <a
        href="/cv"
        data-section="cv"
        class:list={[{ active: currentPath.startsWith('/cv') }]}
        aria-current={currentPath.startsWith('/cv') ? 'page' : undefined}
      >CV</a>
      <a
        href="/blog"
        data-section="blog"
        class:list={[{ active: currentPath.startsWith('/blog') }]}
        aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}
      >Blog</a>
    </nav>
  </div>
</header>

<script>
  import './header-nav.ts';
</script>
